rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/albums/{albumId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'payload', 'revision', 'updatedAt', 'savedAt'])
          && d.keys().hasAll(['name', 'payload', 'revision', 'updatedAt', 'savedAt'])
          && d.name is string && d.name.size() <= 1000
          && d.payload is string && d.payload.size() <= 900000
          && d.revision is int && d.updatedAt is string
          && d.savedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
