# Tất cả VITE_* là cấu hình CÔNG KHAI được nhúng vào frontend.
VITE_GOOGLE_CLIENT_ID=
# Chỉ cần nếu muốn mở thư mục Drive công khai không đăng nhập.
VITE_GOOGLE_API_KEY=
# JSON config web app từ Firebase Console; bỏ trống nếu chỉ dùng trên thiết bị.
VITE_FIREBASE_CONFIG=
VITE_FIREBASE_REGION=asia-southeast1
